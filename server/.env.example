# Copy this file to .env and fill in real values. Never commit .env itself.

# development | staging | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/annadata

# The frontend origin allowed to call this API (Vite's dev server by default)
CORS_ORIGIN=http://localhost:5173

# Secret used to verify JWTs. This backend only verifies tokens for now
# (see Step 2's notes) - a real login endpoint that issues tokens signed
# with this same secret doesn't exist yet. Use a long random string in
# real environments, never this placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# How long an issued token stays valid. Chosen as a reasonable default
# for a farmer app (avoids frequent re-login) - a real refresh-token
# rotation flow is a legitimate future hardening step (per the
# Security & Deployment session), not built as part of this step.
JWT_EXPIRES_IN=7d
