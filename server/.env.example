# Copy this file to .env and fill in real values. Never commit .env itself.

# development | staging | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=8123

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/annadata

# The frontend origin(s) allowed to call this API - comma-separated if
# more than one (e.g. local dev + a temporary public tunnel URL).
CORS_ORIGIN=http://localhost:5173

# Secret used to verify JWTs. This backend only verifies tokens for now
# (see Step 2's notes) - a real login endpoint that issues tokens signed
# with this same secret doesn't exist yet. Use a long random string in
# real environments, never this placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# How long an issued token stays valid. Chosen as a reasonable default
# for a farmer app (avoids frequent re-login) - a real refresh-token
# rotation flow is a legitimate future hardening step (per the
# Security & Deployment session), not built as part of this step.
JWT_EXPIRES_IN=7d

# Gemini API key, from Google AI Studio (https://aistudio.google.com/app/apikey).
# Held only inside src/ai/gateway/ - no other part of the backend
# should ever import the Gemini SDK directly.
GEMINI_API_KEY=replace-with-your-real-gemini-api-key

# Contact email sent in the User-Agent header on every request this
# backend makes to Nominatim/Overpass (OpenStreetMap's free geocoding
# services), per their usage policy:
# https://operations.osmfoundation.org/policies/nominatim/
# Use a real, monitored address in production - OSM may email it if
# this app's traffic ever needs attention.
GEOCODING_CONTACT_EMAIL=dev@example.com

# API key for data.gov.in's Agmarknet mandi price feed (Variety-wise
# Daily Market Prices Data of Commodity - Ministry of Agriculture &
# Farmers Welfare). Defaults to data.gov.in's own public demo key if
# unset, which works but is shared/rate-limited by everyone who hasn't
# registered their own. Get a free key in ~2 minutes at
# https://data.gov.in/user/register (instant approval, no cost) before
# relying on this for real daily syncing.
AGMARKNET_API_KEY=579b464db66ec23bdd000001cdc3b564546246a772a26393094f5645
